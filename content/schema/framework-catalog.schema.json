{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lensatic:framework-catalog.schema:2.0.0-r1",
  "title": "The Lensatic framework catalog",
  "description": "Schema for content/frameworks/catalog.json: the groups, the order of the cards, where other standards land, the comparison and check files, and the navigator's labels.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "modelVersion",
    "checkedOn",
    "intro",
    "groups",
    "frameworks",
    "lands",
    "compares",
    "checks",
    "labels"
  ],
  "properties": {
    "modelVersion": {
      "type": "string",
      "minLength": 1
    },
    "checkedOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "intro": {
      "type": "string",
      "minLength": 1
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "line"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "frameworks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "lands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "owner",
          "what",
          "lands",
          "frameworkIds",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "what": {
            "type": "string",
            "minLength": 1
          },
          "lands": {
            "type": "string",
            "minLength": 1
          },
          "frameworkIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "compares": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "verification": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "verifiedOn",
            "method",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "verified",
                "conflict"
              ]
            },
            "verifiedOn": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "method": {
              "const": "primary-fetch"
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "recheckAfter": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "verifiedOn",
            "method",
            "note",
            "recheckAfter"
          ],
          "properties": {
            "status": {
              "const": "unverified"
            },
            "verifiedOn": {
              "type": "null"
            },
            "method": {
              "const": "none"
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "recheckAfter": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "publisher",
        "title",
        "edition",
        "date",
        "url",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://\\S+$"
        },
        "pdf": {
          "type": "string",
          "pattern": "^https://\\S+\\.pdf$"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "short",
        "line"
      ],
      "properties": {
        "short": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "line": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
