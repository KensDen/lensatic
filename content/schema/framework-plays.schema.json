{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lensatic:framework-plays.schema:2.0.0-r3",
  "title": "The links from the Agentic SecOps plays to the framework navigator",
  "description": "Schema for content/frameworks/play-links.json: for each play in playbook/app/plays.json, the frameworks it touches and, in each, the elements, with one line that says why. The links are Lensatic's own reading and the basis line says so. The story is what Home leads with: a title, its lines and the plays to start with.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "basis",
    "story",
    "plays"
  ],
  "properties": {
    "id": {
      "const": "play-links"
    },
    "basis": {
      "type": "string",
      "minLength": 1
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "line",
        "short",
        "playIds"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "line": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "short": {
          "description": "The story in one line, for the card on a phone.",
          "type": "string",
          "minLength": 1,
          "maxLength": 90
        },
        "playIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "uniqueItems": true
        }
      }
    },
    "plays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "playId",
          "links"
        ],
        "properties": {
          "playId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "links": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "frameworkId",
                "nodeIds",
                "line"
              ],
              "properties": {
                "frameworkId": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "nodeIds": {
                  "description": "The elements, by the publisher's identifiers as the framework's file holds them; empty where the play touches the framework as a whole.",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "line": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 320
                }
              }
            }
          }
        }
      }
    }
  }
}
