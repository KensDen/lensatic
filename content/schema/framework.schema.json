{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lensatic:framework.schema:2.0.0-r2",
  "title": "A Lensatic framework file",
  "description": "Schema for content/frameworks/<id>.json: the card (what the framework is for, who it binds, how it is verified, how big it is, where it sits), its sources and terms, and its structure: levels, nodes that name their parents, sets that select another framework's nodes, and crosswalks a source publishes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "shortName",
    "group",
    "kind",
    "compliance",
    "symbol",
    "color",
    "purpose",
    "what",
    "binds",
    "verifiedBy",
    "size",
    "sits",
    "sources",
    "terms",
    "deadlines",
    "related",
    "depth",
    "levels",
    "nodes",
    "sets",
    "crosswalks"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "entityId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "shortName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 18
    },
    "group": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "compliance": {
      "type": "boolean"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[a-z0-9.]+$"
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "light",
        "dark"
      ],
      "properties": {
        "light": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "dark": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 20,
      "maxLength": 130
    },
    "what": {
      "type": "string",
      "minLength": 20,
      "maxLength": 260
    },
    "binds": {
      "$ref": "#/$defs/fact"
    },
    "verifiedBy": {
      "$ref": "#/$defs/fact"
    },
    "size": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "count",
          "unit"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layers",
        "line"
      ],
      "properties": {
        "layers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "line": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "shows",
        "line",
        "notice",
        "url"
      ],
      "properties": {
        "basis": {
          "enum": [
            "us-government-work",
            "copyrighted",
            "licensed",
            "mitre",
            "publisher"
          ]
        },
        "shows": {
          "enum": [
            "text",
            "titles",
            "structure"
          ]
        },
        "line": {
          "type": "string",
          "minLength": 1
        },
        "notice": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https://\\S+$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "deadlines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "label",
          "short",
          "binds",
          "sourceId"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "short": {
            "type": "string",
            "minLength": 1,
            "maxLength": 28
          },
          "binds": {
            "type": "string",
            "minLength": 1
          },
          "sourceId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        }
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "line"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "line": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "depth": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shown",
            "of",
            "unit",
            "why"
          ],
          "properties": {
            "shown": {
              "type": "integer",
              "minimum": 1
            },
            "of": {
              "type": "integer",
              "minimum": 1
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "why": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "plural"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "plural": {
            "type": "string",
            "minLength": 1
          },
          "identified": {
            "type": "boolean",
            "description": "False where the publisher gives this level no identifiers (the RMF's steps, the CISA model's functions). A node at such a level has an id of the file's own, which the app never shows: it shows the title alone."
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "level",
          "parents"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "parents": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "of",
          "sourceId",
          "members"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "of": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "sourceId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "line": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "The set's screen title where it is not a baseline (CMMC Level 2, Target Level)."
          }
        }
      }
    },
    "crosswalks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "to",
          "relation",
          "edition",
          "sourceId",
          "unresolved",
          "map"
        ],
        "properties": {
          "to": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "relation": {
            "type": "string",
            "minLength": 1
          },
          "edition": {
            "type": "string",
            "minLength": 1
          },
          "sourceId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "unresolved": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "map": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "listed": {
            "type": "boolean",
            "description": "False where the targets are identifiers of a framework whose elements Lensatic does not list (a copyrighted standard). The app then shows the identifiers as the source prints them and counts them; it opens nothing and shows no title."
          },
          "plural": {
            "type": "string",
            "minLength": 1,
            "description": "The relation's plural where adding an s does not make it (References)."
          }
        }
      }
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 420
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "chapterId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "cardSize": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "setsTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "The heading over this framework's sets where they are not baselines (Levels)."
    },
    "setsLine": {
      "type": "string",
      "minLength": 1,
      "description": "The line under the sets where they are not selections of another framework's controls."
    }
  },
  "$defs": {
    "verification": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "verifiedOn",
            "method",
            "note"
          ],
          "properties": {
            "status": {
              "enum": [
                "verified",
                "conflict"
              ]
            },
            "verifiedOn": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "method": {
              "const": "primary-fetch"
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "recheckAfter": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "verifiedOn",
            "method",
            "note",
            "recheckAfter"
          ],
          "properties": {
            "status": {
              "const": "unverified"
            },
            "verifiedOn": {
              "type": "null"
            },
            "method": {
              "const": "none"
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "recheckAfter": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "publisher",
        "title",
        "edition",
        "date",
        "url",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://\\S+$"
        },
        "pdf": {
          "type": "string",
          "pattern": "^https://\\S+\\.pdf$"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "short",
        "line"
      ],
      "properties": {
        "short": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "line": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
