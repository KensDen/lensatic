    "glossaryEntry": {
      "description": "One abbreviation or term the rendered app uses. forms are the spellings to match in rendered text (a prefix entry, such as FY, may be followed by digits); expansion is the spelled-out form as the publisher prints it, or null for a term that is not an abbreviation; notAbbreviation marks a name that its publisher never spells out, such as MITRE or the MIT License, which is matched and linked but never expanded, so its expansion is null; oneLine is a plain sentence for a reader outside federal cybersecurity.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term",
        "forms",
        "expansion",
        "oneLine",
        "entityIds",
        "verification"
      ],
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1
        },
        "forms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prefix": {
          "type": "boolean"
        },
        "notAbbreviation": {
          "type": "boolean"
        },
        "wellKnown": {
          "description": "a term every reader knows; linked to the glossary, never spelled out",
          "type": "boolean"
        },
        "expansion": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "oneLine": {
          "$ref": "#/$defs/prose"
        },
        "entityIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      }
    },
