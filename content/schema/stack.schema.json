          "$ref": "#/$defs/url"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/document"
          }
        },
        "note": {
          "type": "string"
        },
        "authors": {
          "description": "Citation field only: the public authors of a public work, never rendered in prose",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "attributionRequired": {
          "description": "true when the license requires attribution on reuse; a license field is then required",
          "type": "boolean"
        },
        "validatedAgainst": {
          "description": "the model the solution was validated against, what was validated, and when",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entityId",
            "scope",
            "date",
            "verification"
          ],
          "properties": {
            "entityId": {
              "$ref": "#/$defs/id"
            },
            "scope": {
