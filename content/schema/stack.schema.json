            },
            "date": {
              "$ref": "#/$defs/looseDate"
            },
            "verification": {
              "$ref": "#/$defs/verification"
            }
          }
        },
        "adopterResponsibilities": {
          "description": "what an organization that adopts the solution still owns, each statement with its own basis",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "verification"
            ],
            "properties": {
              "text": {
                "$ref": "#/$defs/prose"
              },
              "verification": {
                "$ref": "#/$defs/verification"
              }
            }
          }
        }
      },
      "description": "An implementation vehicle validated against a maturity model: an enterprise service or product line that organizations adopt. Distinct from a framework, which defines or measures, and from a source, which directs."
    },
