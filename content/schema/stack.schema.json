    "verificationRecord": {
      "description": "A checked claim. verified = the primary URL was fetched on the verifiedOn date and title, edition and date match; unverified = the primary could not be reached, and the note records every URL tried; conflict = a mismatch with both values in the note. recheckAfter marks a fact expected to change.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "verifiedOn",
        "method",
        "note"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "unverified",
            "conflict"
          ]
        },
        "verifiedOn": {
          "$ref": "#/$defs/isoDateOrNull"
        },
        "method": {
          "enum": [
            "primary-fetch",
            "none"
          ]
        },
        "note": {
          "type": "string"
        },
        "recheckAfter": {
          "$ref": "#/$defs/isoDateOrNull"
        }
      }
    },
