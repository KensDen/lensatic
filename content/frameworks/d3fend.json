  "purpose": "A common vocabulary for defensive techniques, tied to the attacker techniques they answer.",
  "what": "D3FEND 1.6.0 is a knowledge graph of countermeasures under seven tactics: Model, Harden, Detect, Isolate, Deceive, Evict and Restore.",
  "binds": {
    "short": "No one",
    "line": "Nobody is bound by it, and nothing is audited against it."
  },
  "verifiedBy": {
    "short": "Not a compliance check",
    "line": "D3FEND says it ‘does not prescribe specific countermeasures, it does not prioritize them, and it does not characterize their effectiveness’."
  },
